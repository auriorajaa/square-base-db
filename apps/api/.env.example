# Server
PORT=8080
NODE_ENV=development

# URLs (set WEB_URL to your deployed web URL, e.g. https://your-app.vercel.app)
WEB_URL=http://localhost:3000
API_URL=http://localhost:8080/api

# Database (Neon)
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
REALTIME_DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# JWT
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=

# Resend
RESEND_API_KEY=
INVITE_SECRET=

PROJECT_JWT_SECRET=change-me

# Uploadthing
UPLOADTHING_TOKEN=
